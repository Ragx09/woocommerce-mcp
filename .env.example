# Copy to .env (gitignored). Never commit real values.
# LLM provider for the chat agent (OpenAI-compatible endpoint)
LLM_PROVIDER=groq            # groq | openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional second provider for fallback tests
OPENROUTER_API_KEY=
# GitHub PAT for the GitHub remote MCP upstream (fine-grained, one throwaway repo, Issues: read/write)
GITHUB_MCP_PAT=
