# Copy to .env (gitignored). Never commit real values.
# LLM provider for the chat agent (OpenAI-compatible endpoint)
# LLM_API_KEY goes into the Secret platform/llm-secrets (scripts/make-secrets.sh). Base URL and model
# in the cluster are Helm values (gateway.llm.*); LLM_PROVIDER/LLM_MODEL here only steer llm-smoke.mjs.
LLM_PROVIDER=groq            # groq | openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional second provider for fallback tests
OPENROUTER_API_KEY=
# GitHub PAT for the GitHub remote MCP upstream (fine-grained, one throwaway repo, Issues: read/write)
GITHUB_MCP_PAT=
# VPS (vps-setup/up.sh). Entered once here; up.sh turns them into Kubernetes Secrets / DNS updates.
# DuckDNS: name WITHOUT ".duckdns.org" (woo-demo, not woo-demo.duckdns.org) and the account token from duckdns.org.
# Leave both empty to use <ip>.sslip.io instead.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
# Optional: e-mail for Let's Encrypt expiry notices
ACME_EMAIL=
# Optional: e-mail of the first dashboard admin (default admin@tatva.shop); the password is generated
GATEWAY_ADMIN_EMAIL=
