{
  "name": "@platform/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team MCP gateway: /mcp aggregation, dashboard API, auth, audit and chat",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "start": "node dist/index.js",
    "test:int": "vitest run test/int",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
